{
  "$schema": "https://raw.githubusercontent.com/design-tokens/community-group/main/format/dtcg.json",
  "$metadata": {
    "name": "Soar Boar Design Tokens",
    "description": "Token set for Soar Boar. Cream / Orange / Pink palette with light + dark modes.",
    "figma_instructions": "Variable collections: Colors (Light/Dark modes), Typography, Spacing, Radius. Sync via Figma MCP or Tokens Studio."
  },

  "color": {
    "bg": {
      "base":    { "$value": { "light": "#F5EDE0", "dark": "#1C1917" }, "$type": "color", "$description": "Page background" },
      "surface": { "$value": { "light": "#FFFFFF",  "dark": "#252220" }, "$type": "color", "$description": "Card / panel background" }
    },
    "brand": {
      "primary":   { "$value": { "light": "#E8632B", "dark": "#E8632B" }, "$type": "color", "$description": "Vibrant orange — primary action, highlights" },
      "secondary": { "$value": { "light": "#1A1514", "dark": "#EFE7DD" }, "$type": "color", "$description": "Near-black / near-white — headings, body text" },
      "accent":    { "$value": { "light": "#F0B8C8", "dark": "#3D1E2A" }, "$type": "color", "$description": "Soft pink — hero bg, Soar Boar mascot fill" },
      "green":     { "$value": { "light": "#3EAD6E", "dark": "#4DC87E" }, "$type": "color", "$description": "Soy Boy mode primary — replaces orange" }
    },
    "pos": {
      "1": { "$value": { "light": "#E8632B", "dark": "#E8632B" }, "$type": "color", "$description": "1st letter — 1 pt (orange)" },
      "2": { "$value": { "light": "#9B59B6", "dark": "#9B59B6" }, "$type": "color", "$description": "2nd letter — 4 pts, hardest (purple)" },
      "3": { "$value": { "light": "#2E86C1", "dark": "#2E86C1" }, "$type": "color", "$description": "3rd letter — 3 pts (blue)" },
      "4": { "$value": { "light": "#27AE60", "dark": "#27AE60" }, "$type": "color", "$description": "4th letter — 2 pts (green)" }
    },
    "text": {
      "primary":   { "$value": { "light": "#1A1514", "dark": "#EFE7DD" }, "$type": "color" },
      "secondary": { "$value": { "light": "#8A7A72", "dark": "#8A7A6E" }, "$type": "color" },
      "inverse":   { "$value": { "light": "#FFFFFF",  "dark": "#1C1917" }, "$type": "color" }
    },
    "border": {
      "default": { "$value": { "light": "#E0D0C0", "dark": "#3A3028" }, "$type": "color" }
    },
    "state": {
      "error":   { "$value": { "light": "#C0392B", "dark": "#E56055" }, "$type": "color" },
      "success": { "$value": { "light": "#27AE60", "dark": "#4AC47A" }, "$type": "color" }
    }
  },

  "typography": {
    "family": {
      "display": { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Title, game name, headlines" },
      "ui":      { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Labels, scores, UI copy" },
      "tile":    { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Letter tiles" }
    },
    "size": {
      "xs":   { "$value": "11px", "$type": "dimension" },
      "sm":   { "$value": "13px", "$type": "dimension" },
      "md":   { "$value": "15px", "$type": "dimension" },
      "lg":   { "$value": "20px", "$type": "dimension" },
      "xl":   { "$value": "28px", "$type": "dimension" },
      "2xl":  { "$value": "48px", "$type": "dimension", "$description": "Hero wordmark" },
      "tile": { "$value": "28px", "$type": "dimension", "$description": "Letter inside a tile" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "medium":  { "$value": "500", "$type": "fontWeight" },
      "semibold":{ "$value": "600", "$type": "fontWeight" },
      "bold":    { "$value": "700", "$type": "fontWeight" },
      "xbold":   { "$value": "800", "$type": "fontWeight" },
      "black":   { "$value": "900", "$type": "fontWeight", "$description": "Hero wordmark, wordmark" }
    },
    "lineHeight": {
      "tight":  { "$value": "1.1", "$type": "number" },
      "normal": { "$value": "1.5", "$type": "number" }
    }
  },

  "spacing": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },

  "size": {
    "tile":     { "$value": "64px", "$type": "dimension", "$description": "Width and height of a letter tile" },
    "tileSm":   { "$value": "40px", "$type": "dimension", "$description": "Played word tile (chain view)" },
    "timerBar": { "$value": "6px",  "$type": "dimension", "$description": "Timer bar height" }
  },

  "radius": {
    "sm":   { "$value": "8px",    "$type": "dimension" },
    "md":   { "$value": "16px",   "$type": "dimension", "$description": "Tiles" },
    "lg":   { "$value": "24px",   "$type": "dimension", "$description": "Cards, hero" },
    "btn":  { "$value": "14px",   "$type": "dimension", "$description": "Buttons" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },

  "shadow": {
    "card":  { "$value": "0 4px 20px rgba(26,21,20,0.06)", "$type": "shadow" },
    "focus": { "$value": "0 0 0 3px rgba(232,99,43,0.25)", "$type": "shadow" }
  },

  "motion": {
    "duration": {
      "fast":   { "$value": "120ms", "$type": "duration" },
      "normal": { "$value": "220ms", "$type": "duration" },
      "slow":   { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "default": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",      "$type": "cubicBezier" },
      "bounce":  { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "cubicBezier" }
    }
  }
}
